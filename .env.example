# Copy this file to .env.local or another ignored .env.* file.
# Do not put real passwords or API tokens in committed files.

AUTODL_HOST=connect.bjb2.seetacloud.com
AUTODL_PORT=26034
AUTODL_USER=root
AUTODL_PROJECT=/root/autodl-tmp/pdf2latex_nn

# Kaggle CLI 2.1+ can read an access token from this file path.
# The token file itself must be ignored and chmod 600.
KAGGLE_API_TOKEN=/path/to/.kaggle/access_token
KAGGLE_CONFIG_DIR=/path/to/.kaggle

# Portable path configuration. Prefer setting these in .env.local or shell
# profile on each machine, not in committed source files.
PDF2LATEX_PROJECT_ROOT=/path/to/pdf2latex_nn
PDF2LATEX_DATA_ROOT=/path/to/pdf2latex_data
PDF2LATEX_OUTPUT_ROOT=/path/to/pdf2latex_outputs
PDF2LATEX_REPORT_ROOT=/path/to/pdf2latex_reports
PDF2LATEX_RUNTIME_ROOT=/path/to/pdf2latex_runtime
PDF2LATEX_PAPER_ROOT=/path/to/pdf2latex_paper
PDF2LATEX_AUTODL_ROOT=/root/autodl-tmp/pdf2latex_nn
PDF2LATEX_CONFIG=/path/to/pdf2latex_nn/config/paths.local.yaml
